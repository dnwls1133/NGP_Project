# EditorConfig helps developers define and maintain consistent coding styles between different editors and IDEs

root = true

# 모든 파일에 대한 설정
[*]
charset = utf-8-bom
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# C++에 대한 설정
[*.cpp]
indent_size = 4
indent_style = space
max_line_length = 80
insert_final_newline = true
trim_trailing_whitespace = true
